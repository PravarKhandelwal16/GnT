# Copy to backend/.env and fill in. backend/.env is git-ignored.

# Required: generate with `openssl rand -base64 48`
JWT_SECRET=

# MySQL (`docker compose up -d` provides this exact setup)
DB_URL=jdbc:mysql://localhost:3306/gnt?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=gnt
DB_PASSWORD=gnt_local_password

# Optional: ImageKit. Leave blank to store uploads in backend/uploads.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Optional: SMTP for password-reset email. When blank, the reset link is logged instead.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com

# Comma-separated emails that become owners (admins) when they sign up
OWNER_EMAILS=

# Starter products from two sample sellers (Asha Rao, Rohan Mehta). Set false to skip.
SAMPLE_DATA=true
# Optional: password for the sample sellers, so you can log in as them
# (asha@samples.giveandtake.invalid, rohan@samples.giveandtake.invalid). Blank = nobody can.
SAMPLE_SELLER_PASSWORD=

# Set to true to serve Swagger UI at /swagger-ui.html
API_DOCS_ENABLED=false

# Deployment
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
